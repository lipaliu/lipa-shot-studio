HOST=127.0.0.1
PORT=4318
# 公网部署必须设置至少 12 位访问密码，并在反向代理上启用 HTTPS。
APP_PASSWORD=
# 公网 HTTPS 时设为 true
COOKIE_SECURE=false
DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=claude-opus-5-5
# 可选：使用 OpenAI 兼容网关时设置其 /v1 Base URL。
# OPENAI_BASE_URL=https://toapis.cn/v1
IMAGE_BASE_URL=https://toapis.cn/v1
IMAGE_MODEL=gpt-image-2
# IMAGE_API_KEY=  # 留空时可在页面中选择复用 ToAPIs / 兼容文字 API Key
DOUBAO_API_KEY=
DOUBAO_MODEL=
# 默认豆包北京方舟端点；支持在服务端设置其他官方区域。
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
